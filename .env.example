# Copy to .env and fill in.
# ANTHROPIC_API_KEY=sk-ant-...   (leave commented out if you use `ant auth login`)
LLM_PROVIDER=anthropic          # anthropic | fake
LLM_EXTRACT_MODEL=claude-opus-5-5    # metric extraction
LLM_CHAT_MODEL=claude-sonnet-5-5     # Q&A agent and briefs
LLM_EFFORT=medium               # low | medium | high | xhigh | max
LLM_FALLBACKS=default           # server-side refusal fallback; empty to disable
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DB_PATH=data/deal_room.db
AGENT_MAX_STEPS=6
WEB_SEARCH_PROVIDER=tavily      # tavily | fake | empty to turn web research off
# TAVILY_API_KEY=tvly-...       (web research is skipped while this is not set)
